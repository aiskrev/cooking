---
import TermPage from '../../../views/TermPage.astro';
import { getRecipes, getTags } from '../../../lib/recipes';

export async function getStaticPaths() {
  const recipes = await getRecipes('en');
  return getTags(recipes, 'en').map((term) => ({ params: { slug: term.slug }, props: { termKey: term.key } }));
}
const { termKey } = Astro.props;
---
<TermPage locale="en" kind="tag" termKey={termKey} />
