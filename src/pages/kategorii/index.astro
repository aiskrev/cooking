---
import Base from '../../layouts/Base.astro';
import { getRecipes, getCategories, getTags } from '../../lib/recipes';

const recipes = await getRecipes();
const categories = getCategories(recipes);
const tags = getTags(recipes);
---
<Base title="Категории и етикети" description="Разгледайте рецептите по категории и етикети.">
  <div class="wrap">
    <div class="page-head"><h1>Категории и етикети</h1></div>
    <section class="section" aria-labelledby="h-c">
      <h2 id="h-c">Категории</h2>
      <ul class="chips">
        {categories.map((c) => (
          <li><a href={`/kategorii/${c.slug}/`}>{c.name}<span class="count">{c.recipes.length}</span></a></li>
        ))}
      </ul>
    </section>
    {tags.length > 0 && (
      <section class="section" aria-labelledby="h-t">
        <h2 id="h-t">Етикети</h2>
        <ul class="chips">
          {tags.map((t) => (
            <li><a href={`/etiketi/${t.slug}/`}>{t.name}<span class="count">{t.recipes.length}</span></a></li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Base>
