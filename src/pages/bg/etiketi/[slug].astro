---
import TermPage from '../../../views/TermPage.astro';
import { getRecipes, getTags } from '../../../lib/recipes';

export async function getStaticPaths() {
  const recipes = await getRecipes('bg');
  return getTags(recipes, 'bg').map((term) => ({ params: { slug: term.slug }, props: { termKey: term.key } }));
}
const { termKey } = Astro.props;
---
<TermPage locale="bg" kind="tag" termKey={termKey} />
