---
import Base from '../layouts/Base.astro';
---
<Base title="Списък за пазаруване" description="Вашият списък за пазаруване със съставки от избраните рецепти – записва се само във вашия браузър.">
  <div class="wrap">
    <div class="page-head">
      <h1>Списък за пазаруване</h1>
      <p>Съставките, които добавите от рецептите, се пазят само във вашия браузър – без профил и без сървър.</p>
    </div>
    <div class="actions">
      <button type="button" class="btn small" data-copy-all>Копирай целия списък</button>
      <button type="button" class="btn small secondary" data-print-list>Отпечатай</button>
      <button type="button" class="btn small secondary" data-clear>Изчисти списъка</button>
    </div>
    <p class="muted" role="status" aria-live="polite" data-status></p>
    <div data-list class="shop-list"></div>
    <p class="empty" data-empty hidden>Списъкът е празен. Отворете рецепта и натиснете „Добави в списъка за пазаруване“.</p>
    <noscript><p>Списъкът за пазаруване изисква JavaScript.</p></noscript>
  </div>
</Base>

<script>
  type Entry = { slug: string; title: string; servings: number; items: string[] };
  const box = document.querySelector<HTMLElement>('[data-list]')!;
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  const status = document.querySelector<HTMLElement>('[data-status]')!;
  const load = (): Entry[] => { try { return JSON.parse(localStorage.getItem('shopping-list') || '[]'); } catch { return []; } };
  const save = (l: Entry[]) => { try { localStorage.setItem('shopping-list', JSON.stringify(l)); } catch {} };
  let checked = new Set<string>();
  try { checked = new Set(JSON.parse(localStorage.getItem('shopping-checked') || '[]')); } catch {}
  const saveChecked = () => { try { localStorage.setItem('shopping-checked', JSON.stringify([...checked])); } catch {} };

  function render() {
    const list = load();
    box.replaceChildren();
    empty.hidden = list.length > 0;
    for (const e of list) {
      const sec = document.createElement('section');
      const h = document.createElement('h2'); const a = document.createElement('a'); a.href = `/recepti/${e.slug}/`; a.textContent = e.title; h.appendChild(a);
      const sub = document.createElement('p'); sub.className = 'muted'; sub.textContent = `За ${e.servings} порции`;
      const rm = document.createElement('button'); rm.type = 'button'; rm.className = 'link-btn'; rm.textContent = 'Премахни рецептата';
      rm.addEventListener('click', () => { save(load().filter((x) => x.slug !== e.slug)); render(); });
      const ul = document.createElement('ul'); ul.className = 'ing-list';
      e.items.forEach((t) => {
        const id = `${e.slug}::${t}`;
        const li = document.createElement('li'); const lab = document.createElement('label'); const cb = document.createElement('input'); cb.type = 'checkbox'; cb.className = 'ing-check'; cb.checked = checked.has(id);
        const sp = document.createElement('span'); sp.className = 'ing-text'; sp.textContent = t;
        cb.addEventListener('change', () => { cb.checked ? checked.add(id) : checked.delete(id); saveChecked(); });
        lab.append(cb, sp); li.appendChild(lab); ul.appendChild(li);
      });
      sec.append(h, sub, ul, rm); box.appendChild(sec);
    }
  }
  document.querySelector('[data-copy-all]')?.addEventListener('click', async () => {
    const text = load().map((e) => `${e.title}\n${e.items.map((i) => `• ${i}`).join('\n')}`).join('\n\n');
    try { await navigator.clipboard.writeText(text); status.textContent = 'Списъкът е копиран.'; } catch { status.textContent = 'Копирането не е възможно в този браузър.'; }
  });
  document.querySelector('[data-print-list]')?.addEventListener('click', () => window.print());
  document.querySelector('[data-clear]')?.addEventListener('click', () => { if (confirm('Да изчистя ли целия списък?')) { save([]); checked.clear(); saveChecked(); render(); } });
  render();
</script>
