---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import Lightbox from '../../components/Lightbox.astro';
import { getRecipes, getPhotos, type Photo as PhotoT } from '../../lib/recipes';
import { ogImage, schemaImages, stepImageUrl, thumbUrl } from '../../lib/images';
import { formatMinutes, formatDate, isoDuration, pluralPortions, slugify } from '../../lib/text';
import { site, illustrativeNote } from '../../site.config';

export async function getStaticPaths() {
  const recipes = await getRecipes();
  return recipes.map((recipe) => ({ params: { slug: recipe.id }, props: { recipe } }));
}

const { recipe } = Astro.props;
const d = recipe.data;
const { Content } = await render(recipe);
const photos = await getPhotos(recipe);
const all = [...photos.values()];
const cover: PhotoT | undefined = d.cover ? photos.get(d.cover) : all[0];
const usedInSteps = new Set(d.steps.flatMap((s) => (s.photo ? [s.photo] : [])));
const extras = all.filter((p) => !usedInSteps.has(p.file) && p.file !== cover?.file);
const total = d.prepTime + d.cookTime;
const url = new URL(Astro.url.pathname, Astro.site).href;

const og = cover ? await ogImage(cover, Astro.site) : undefined;
const thumb = cover ? await thumbUrl(cover) : undefined;
const ldImages = cover ? await schemaImages(cover, Astro.site) : [];
const ldSteps = await Promise.all(
  d.steps.map(async (s, i) => {
    const p = s.photo ? photos.get(s.photo) : undefined;
    return {
      '@type': 'HowToStep',
      name: s.title ?? `Стъпка ${i + 1}`,
      text: s.text,
      url: `${url}#stapka-${i + 1}`,
      ...(p ? { image: await stepImageUrl(p, Astro.site) } : {}),
    };
  }),
);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Recipe',
  name: d.title,
  description: d.description,
  inLanguage: site.lang,
  url,
  mainEntityOfPage: url,
  author: { '@type': 'Organization', name: site.author },
  datePublished: d.date.toISOString().slice(0, 10),
  ...(d.updated ? { dateModified: d.updated.toISOString().slice(0, 10) } : {}),
  ...(ldImages.length ? { image: ldImages } : {}),
  prepTime: isoDuration(d.prepTime),
  cookTime: isoDuration(d.cookTime),
  totalTime: isoDuration(total),
  recipeYield: [String(d.servings), pluralPortions(d.servings)],
  recipeCategory: d.category,
  ...(d.tags.length ? { keywords: d.tags.join(', ') } : {}),
  recipeIngredient: d.ingredients.flatMap((g) => g.items),
  recipeInstructions: ldSteps,
};
const crumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Начало', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Рецепти', item: new URL('/recepti/', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: d.title },
  ],
};
---
<Base
  title={d.title}
  description={d.description}
  type="article"
  image={og && cover ? { ...og, alt: cover.alt } : undefined}
  jsonLd={[jsonLd, crumbs]}
  published={d.date}
  modified={d.updated}
>
  <article class="wrap recipe" data-pagefind-body>
    <span hidden data-pagefind-filter="category[data-v]" data-v={d.category}></span>
    {thumb && <span hidden data-pagefind-meta="image[data-src]" data-src={thumb}></span>}
    <nav class="breadcrumb" aria-label="Път до страницата">
      <ol>
        <li><a href="/">Начало</a></li>
        <li><a href="/recepti/">Рецепти</a></li>
        <li aria-current="page">{d.title}</li>
      </ol>
    </nav>

    {d.review && (
      <div class="notice" role="note">
        <strong>Чернова – чака проверка от автора</strong>
        <p>Текстът на тази рецепта (съставки, количества, температура и време) е примерен и още не е проверен. Не го публикувайте, преди да го потвърдите.</p>
      </div>
    )}

    <header class="recipe-head">
      <div>
        <h1>{d.title}</h1>
        <p class="lead">{d.description}</p>
        <dl class="facts">
          <div><dt>Подготовка</dt><dd>{formatMinutes(d.prepTime)}</dd></div>
          <div><dt>Готвене</dt><dd>{formatMinutes(d.cookTime)}</dd></div>
          <div><dt>Общо време</dt><dd>{formatMinutes(total)}</dd></div>
          <div><dt>Порции</dt><dd>{d.servings}</dd></div>
          {d.difficulty && <div><dt>Трудност</dt><dd>{d.difficulty}</dd></div>}
        </dl>
        <p class="muted">
          Категория: <a href={`/kategorii/${slugify(d.category)}/`}>{d.category}</a>
          · Публикувано на <time datetime={d.date.toISOString().slice(0, 10)}>{formatDate(d.date)}</time>
        </p>
        <div class="actions">
          <a class="btn" href="#sastavki">Към съставките</a>
          <button type="button" class="btn secondary" data-print>Отпечатай рецептата</button>
        </div>
      </div>
      {cover && (
        <figure class="hero-fig">
          <Photo
            photo={cover}
            zoom
            eager
            class="hero-photo"
            sizes="(min-width: 900px) 416px, calc(100vw - 32px)"
           
          />
          {d.illustrative && <p class="photo-note"><span class="badge">{illustrativeNote.badge}</span></p>}
        </figure>
      )}
    </header>

    {d.illustrative && (
      <div class="notice illustrative" role="note">
        <strong>{illustrativeNote.badge}</strong>
        <p>{illustrativeNote.text}</p>
      </div>
    )}

    <div class="recipe-grid">
      <section class="ingredients" id="sastavki" aria-labelledby="h-sastavki">
        <h2 id="h-sastavki">Съставки</h2>
        <p class="muted">За {pluralPortions(d.servings)}</p>
        {d.ingredients.map((g) => (
          <>
            {g.title && <h3>{g.title}</h3>}
            <ul>{g.items.map((i) => <li>{i}</li>)}</ul>
          </>
        ))}
      </section>

      <section aria-labelledby="h-prigotvyane">
        <h2 id="h-prigotvyane">Приготвяне</h2>
        <ol class="steps">
          {d.steps.map((s, i) => {
            const p = s.photo ? photos.get(s.photo) : undefined;
            return (
              <li class="step" id={`stapka-${i + 1}`}>
                <div>
                  {s.title && <h3>{s.title}</h3>}
                  <p class="step-text">{s.text}</p>
                </div>
                {p && (
                  <figure class="step-photo">
                    <Photo photo={p} zoom sizes="(min-width: 640px) 416px, calc(100vw - 32px)" />
                    {p.caption && <figcaption>{p.caption}</figcaption>}
                  </figure>
                )}
              </li>
            );
          })}
        </ol>
      </section>
    </div>

    <section class="notes" aria-label="Бележки"><Content /></section>

    {extras.length > 0 && (
      <section class="more-photos" aria-labelledby="h-more">
        <h2 id="h-more">Още снимки</h2>
        <ul class="thumbs">
          {extras.map((p) => (
            <li><Photo photo={p} zoom widths={[360]} sizes="(min-width: 640px) 160px, 45vw" /></li>
          ))}
        </ul>
      </section>
    )}

    {d.tags.length > 0 && (
      <section class="tags" aria-labelledby="h-tags">
        <h2 id="h-tags">Етикети</h2>
        <ul class="chips">
          {d.tags.map((t) => <li><a href={`/etiketi/${slugify(t)}/`}>{t}</a></li>)}
        </ul>
      </section>
    )}

    <p class="print-only">Рецептата е от {site.name} – {url}</p>
  </article>
  <Lightbox />
</Base>
