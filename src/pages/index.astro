---
// Корен на сайта: сървърът (Caddy) пренасочва „/“ към „/bg/“ със статус 301. Тази страница е само резервен вариант
// (напр. при преглед без Caddy) и не се индексира; връзката е видима и без JavaScript.
import { href } from '../i18n';
const target = href('bg');
---
<!doctype html>
<html lang="bg">
  <head>
    <meta charset="utf-8" />
    <title>Модерна българска кухня и Мишлен щрих</title>
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={new URL(target, Astro.site).href} />
  </head>
  <body>
    <p><a href={target}>Български</a> · <a href={href('en')} lang="en">English</a></p>
  </body>
</html>
