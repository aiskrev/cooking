---
// Любими рецепти: списъкът е само в браузъра на посетителя (localStorage), без регистрация. Страницата съдържа всички рецепти скрити и показва избраните.
import Base from '../layouts/Base.astro';
import RecipeCard from '../components/RecipeCard.astro';
import { getRecipes } from '../lib/recipes';
const recipes = await getRecipes();
---
<Base title="Любими рецепти" description="Рецептите, които сте запазили в този браузър." noindex>
  <div class="wrap">
    <div class="page-head">
      <h1>Любими рецепти</h1>
      <p class="muted">Пазят се само в този браузър – без регистрация. Изчистването на данните на сайта ги изтрива.</p>
    </div>
    <p class="empty" data-fav-empty hidden>Още нямате любими рецепти. Отворете рецепта и натиснете „♡ Запази в любими“.</p>
    <ul class="grid section" data-fav-grid>
      {recipes.map((r) => <li data-fav-item hidden><RecipeCard recipe={r} level={2} /></li>)}
    </ul>
    <noscript><p class="muted">Любимите рецепти изискват JavaScript.</p></noscript>
  </div>
</Base>

<script>
  const read = (): string[] => { try { return JSON.parse(localStorage.getItem('favorites') ?? '[]'); } catch { return []; } };
  const grid = document.querySelector<HTMLElement>('[data-fav-grid]')!;
  const empty = document.querySelector<HTMLElement>('[data-fav-empty]')!;
  function render() {
    const favs = new Set(read());
    let shown = 0;
    grid.querySelectorAll<HTMLElement>('[data-fav-item]').forEach((li) => {
      const slug = li.querySelector<HTMLElement>('[data-slug]')?.dataset.slug ?? '';
      const on = favs.has(slug);
      li.hidden = !on;
      if (on) shown++;
      if (on && !li.querySelector('.fav-remove')) {
        const b = document.createElement('button');
        b.type = 'button'; b.className = 'btn secondary small fav-remove'; b.textContent = 'Премахни от любими';
        b.addEventListener('click', () => { try { localStorage.setItem('favorites', JSON.stringify(read().filter((x) => x !== slug))); } catch { /* */ } render(); });
        li.querySelector('.card-body')?.append(b);
      }
    });
    empty.hidden = shown > 0;
  }
  render();
</script>
