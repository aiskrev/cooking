---
// Фото-история: до 10 кадъра по реда на готвенето, плъзгане/стрелки, увеличаване по клик.
import type { Photo as PhotoT } from '../lib/recipes';
import Photo from './Photo.astro';
import { t, type Locale } from '../i18n';
interface Props { locale: Locale; items: Array<{ photo: PhotoT; lite: boolean }>; title: string }
const { locale, items, title } = Astro.props;
---
<section class="story" aria-roledescription={t(locale, 'story.roledesc')} aria-label={t(locale, 'story.aria', { title })} data-carousel>
  <div class="story-head">
    <h2>{t(locale, 'story.title')}</h2>
    <p class="muted">{t(locale, 'story.count', { n: items.length })}</p>
    <div class="story-nav">
      <button type="button" class="round-btn" data-prev aria-label={t(locale, 'story.prev')}>‹</button>
      <button type="button" class="round-btn" data-next aria-label={t(locale, 'story.next')}>›</button>
    </div>
  </div>
  <ol class="story-track" tabindex="0" aria-label={t(locale, 'story.track')}>
    {items.map(({ photo, lite }, i) => (
      <li class="story-slide">
        <figure>
          <Photo locale={locale} photo={photo} zoom lite={lite} label={t(locale, 'photo.zoomLabel', { n: i + 1, text: photo.caption ?? photo.alt })} sizes="(min-width: 960px) 300px, 70vw" widths={[480, 800]} class="story-photo" />
          <figcaption><span class="story-no">{i + 1}</span> {photo.caption}</figcaption>
        </figure>
      </li>
    ))}
  </ol>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.story-track')!;
    const step = () => Math.max(track.clientWidth * 0.85, 240);
    root.querySelector('[data-prev]')?.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    root.querySelector('[data-next]')?.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); track.scrollBy({ left: step(), behavior: 'smooth' }); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); track.scrollBy({ left: -step(), behavior: 'smooth' }); }
    });
  });
</script>
