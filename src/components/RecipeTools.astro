---
// Инструменти към рецептата: преоразмеряване на порциите, копиране на списък, списък за пазаруване, режим „готвене“.
import { t, href, type Locale } from '../i18n';
interface Props { locale: Locale; servings: number; canScale: boolean }
const { locale, servings, canScale } = Astro.props;
---
<div class="tools" data-tools>
  {canScale && (
    <div class="scaler" role="group" aria-label={t(locale, 'tools.servingsGroup')}>
      <button type="button" class="round-btn" data-minus aria-label={t(locale, 'tools.less')}>−</button>
      <output data-servings aria-live="polite">{servings}</output>
      <span class="scaler-label">{t(locale, 'tools.servingsLabel')}</span>
      <button type="button" class="round-btn" data-plus aria-label={t(locale, 'tools.more')}>+</button>
      <button type="button" class="link-btn" data-reset hidden>{t(locale, 'tools.resetTo', { n: servings })}</button>
    </div>
  )}
  <div class="list-actions">
    <button type="button" class="btn small secondary" data-copy>{t(locale, 'tools.copy')}</button>
    <button type="button" class="btn small secondary" data-add-list>{t(locale, 'tools.addToList')}</button>
    <a class="small" href={href(locale, 'shopping')}>{t(locale, 'tools.myList')}</a>
  </div>
  <p class="muted small" role="status" aria-live="polite" data-tools-status></p>
</div>

<script>
  import { tc, locale } from '../i18n/client';
  import { ingredientLine, type Ing } from '../i18n/ingredients';

  type IngData = { titles: Record<string, string | undefined>; lines: Record<string, Ing[] | undefined> };
  const ingData: IngData | null = (() => { try { return JSON.parse(document.getElementById('ing-data')?.textContent || 'null'); } catch { return null; } })();

  const root = document.querySelector<HTMLElement>('[data-recipe]');
  if (root) {
    const base = Number(root.dataset.baseServings || 1);
    let servings = base;
    const ings = [...root.querySelectorAll<HTMLElement>('[data-ing]')];
    const out = root.querySelector<HTMLOutputElement>('[data-servings]');
    const reset = root.querySelector<HTMLElement>('[data-reset]');
    const status = root.querySelector<HTMLElement>('[data-tools-status]')!;
    const mine = ingData?.lines[locale] ?? [];

    const render = () => {
      const k = servings / base;
      ings.forEach((li, idx) => {
        const ing = mine[idx];
        if (!ing || !ing.s) return;
        li.querySelector<HTMLElement>('.ing-text')!.textContent = ingredientLine(locale, ing, k);
      });
      if (out) out.textContent = String(servings);
      if (reset) reset.hidden = servings === base;
      document.dispatchEvent(new CustomEvent('recipe:scaled'));
    };
    root.querySelector('[data-minus]')?.addEventListener('click', () => { servings = Math.max(1, servings - 1); render(); });
    root.querySelector('[data-plus]')?.addEventListener('click', () => { servings = Math.min(24, servings + 1); render(); });
    reset?.addEventListener('click', () => { servings = base; render(); });

    // Избрани (отметнатите) или всички съставки – по индекс, за да може същият избор да се запише и на двата езика
    const selected = () => {
      const checked = ings.map((li, i) => (li.querySelector<HTMLInputElement>('.ing-check')?.checked ? i : -1)).filter((i) => i >= 0);
      return checked.length ? checked : ings.map((_, i) => i);
    };
    const lines = () => selected().map((i) => ings[i].querySelector('.ing-text')!.textContent!.trim());
    const say = (t: string) => { status.textContent = t; };
    root.querySelector('[data-copy]')?.addEventListener('click', async () => {
      const text = lines().map((l) => `• ${l}`).join('\n');
      try { await navigator.clipboard.writeText(text); say(tc('tools.copied')); }
      catch {
        const ta = document.createElement('textarea'); ta.value = text; document.body.appendChild(ta); ta.select();
        try { document.execCommand('copy'); say(tc('tools.copied')); } catch { say(tc('tools.copyFail')); }
        ta.remove();
      }
    });
    root.querySelector('[data-add-list]')?.addEventListener('click', () => {
      try {
        // Стабилният идентификатор на рецептата е последният сегмент от адреса – еднакъв в двата езика
        const slug = location.pathname.split('/').filter(Boolean).pop()!;
        const list = JSON.parse(localStorage.getItem('shopping-list') || '[]').filter((x: any) => x.slug !== slug);
        const idx = selected();
        const k = servings / base;
        // редовете се записват и на двата езика (ако рецептата има превод), за да се показват на избрания език
        const byLang: Record<string, string[]> = {};
        for (const l of ['bg', 'en'] as const) {
          const src = ingData?.lines[l];
          if (src) byLang[l] = idx.map((i) => (src[i] ? ingredientLine(l, src[i], k) : '')).filter(Boolean);
        }
        byLang[locale] = lines();
        const titles: Record<string, string> = {};
        for (const l of ['bg', 'en']) { const tt = ingData?.titles[l]; if (tt) titles[l] = tt; }
        titles[locale] = titles[locale] ?? (document.querySelector('h1')?.textContent ?? slug).trim();
        list.push({ slug, servings, titles, items: byLang[locale], itemsByLang: byLang });
        localStorage.setItem('shopping-list', JSON.stringify(list));
        say(tc('tools.added', { n: byLang[locale].length }));
      } catch { say(tc('tools.addFail')); }
    });
  }

  // ---------------- Режим „готвене“ ----------------
  const dataEl = document.getElementById('cook-data');
  const openBtn = document.querySelector<HTMLElement>('[data-cook-open]');
  if (dataEl && openBtn) {
    const data = JSON.parse(dataEl.textContent || '{}') as { title: string; steps: { n: number; title: string; text: string; why: string; cue: string; avoid: string; time: number }[] };
    let dlg: HTMLDialogElement | null = null;
    let idx = 0, wake: any = null, timer: number | undefined, left = 0;
    const $ = <T extends HTMLElement>(s: string) => dlg!.querySelector<T>(s)!;
    const pad = (n: number) => String(n).padStart(2, '0');

    async function lock() { try { wake = await (navigator as any).wakeLock?.request('screen'); } catch { wake = null; } }
    function unlock() { try { wake?.release(); } catch {} wake = null; }

    function stopTimer() { clearInterval(timer); timer = undefined; }
    function drawTimer() {
      $('.ck-clock').textContent = `${pad(Math.floor(left / 60))}:${pad(left % 60)}`;
    }
    function show(i: number) {
      idx = Math.max(0, Math.min(data.steps.length - 1, i));
      const s = data.steps[idx];
      stopTimer();
      $('.ck-progress').textContent = tc('cook.progress', { n: idx + 1, total: data.steps.length });
      $('.ck-bar-fill').className = 'ck-bar-fill w' + Math.round(((idx + 1) / data.steps.length) * 10) * 10;
      $('.ck-title').textContent = s.title || tc('recipe.step', { n: idx + 1 });
      $('.ck-text').textContent = s.text;
      const notes = $('.ck-notes'); notes.replaceChildren();
      for (const [label, v, cls] of [[tc('recipe.why').replace(/:$/, ''), s.why, ''], [tc('recipe.cue').replace(/:$/, ''), s.cue, ''], [tc('recipe.avoid').replace(/:$/, ''), s.avoid, 'avoid']] as const) {
        if (!v) continue;
        const p = document.createElement('p'); p.className = 'ck-note ' + cls;
        const b = document.createElement('strong'); b.textContent = label + ': ';
        p.append(b, v); notes.appendChild(p);
      }
      const tw = $('.ck-timer');
      tw.hidden = !s.time; left = s.time * 60; if (s.time) drawTimer();
      $('.ck-start').textContent = tc('cook.start');
      $('.ck-done').textContent = '';
      const img = document.querySelector<HTMLImageElement>(`#stapka-${s.n} .step-photo img:not(.lqip)`);
      const ph = $('.ck-photo'); ph.replaceChildren();
      const src = img?.currentSrc || img?.src; // ленивите снимки още нямат currentSrc
      if (img && src) { const im = document.createElement('img'); im.src = src; im.alt = img.alt || ''; ph.appendChild(im); }
      ($('.ck-prev') as HTMLButtonElement).disabled = idx === 0;
      ($('.ck-next') as HTMLButtonElement).textContent = idx === data.steps.length - 1 ? tc('cook.done') : tc('cook.next');
    }
    function syncIngredients() {
      const list = $('.ck-ings'); list.replaceChildren();
      document.querySelectorAll<HTMLElement>('[data-recipe] [data-ing]').forEach((li) => {
        const src = li.querySelector<HTMLInputElement>('.ing-check')!;
        const row = document.createElement('li'); const lab = document.createElement('label'); const cb = document.createElement('input'); cb.type = 'checkbox'; cb.checked = src.checked;
        const span = document.createElement('span'); span.textContent = li.querySelector('.ing-text')!.textContent;
        cb.addEventListener('change', () => { src.checked = cb.checked; });
        lab.append(cb, span); row.appendChild(lab); list.appendChild(row);
      });
    }
    function build() {
      dlg = document.createElement('dialog');
      dlg.className = 'cook';
      dlg.setAttribute('aria-label', tc('cook.label', { title: data.title }));
      dlg.innerHTML = `
        <div class="ck-top"><div><p class="ck-recipe"></p><p class="ck-progress" aria-live="polite"></p></div>
          <div class="ck-top-btns"><button type="button" class="ck-btn ck-ing-toggle" aria-expanded="false"></button><button type="button" class="ck-btn ck-close"></button></div></div>
        <div class="ck-bar"><div class="ck-bar-fill"></div></div>
        <div class="ck-main"><div class="ck-step"><h2 class="ck-title"></h2><p class="ck-text"></p><div class="ck-notes"></div>
          <div class="ck-timer" hidden><span class="ck-clock" role="timer"></span><button type="button" class="ck-btn ck-start"></button><button type="button" class="ck-btn ck-reset"></button><span class="ck-done" role="status"></span></div></div>
          <div class="ck-photo"></div>
          <aside class="ck-panel" hidden><h3></h3><ul class="ck-ings"></ul></aside></div>
        <div class="ck-foot"><button type="button" class="ck-btn ck-prev"></button><button type="button" class="ck-btn primary ck-next"></button></div>`;
      document.body.appendChild(dlg);
      $('.ck-recipe').textContent = data.title;
      $('.ck-ing-toggle').textContent = tc('cook.ingredients');
      $('.ck-close').textContent = tc('cook.close');
      $('.ck-reset').textContent = tc('cook.reset');
      $('.ck-prev').textContent = tc('cook.prev');
      $('.ck-panel h3').textContent = tc('cook.ingredients');
      $('.ck-close').addEventListener('click', () => dlg!.close());
      $('.ck-prev').addEventListener('click', () => show(idx - 1));
      $('.ck-next').addEventListener('click', () => { if (idx === data.steps.length - 1) dlg!.close(); else show(idx + 1); });
      $('.ck-ing-toggle').addEventListener('click', (e) => {
        const p = $('.ck-panel'); p.hidden = !p.hidden; (e.currentTarget as HTMLElement).setAttribute('aria-expanded', String(!p.hidden)); if (!p.hidden) syncIngredients();
      });
      $('.ck-start').addEventListener('click', () => {
        if (timer) { stopTimer(); $('.ck-start').textContent = tc('cook.resume'); return; }
        if (left <= 0) return;
        $('.ck-start').textContent = tc('cook.pause');
        timer = window.setInterval(() => {
          left--; drawTimer();
          if (left <= 0) { stopTimer(); $('.ck-start').textContent = tc('cook.start'); $('.ck-done').textContent = tc('cook.timeUp'); try { navigator.vibrate?.([300, 150, 300]); } catch {} }
        }, 1000);
      });
      $('.ck-reset').addEventListener('click', () => { stopTimer(); left = data.steps[idx].time * 60; drawTimer(); $('.ck-start').textContent = tc('cook.start'); $('.ck-done').textContent = ''; });
      dlg.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') { e.preventDefault(); if (idx < data.steps.length - 1) show(idx + 1); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); show(idx - 1); }
      });
      dlg.addEventListener('close', () => { stopTimer(); unlock(); document.documentElement.classList.remove('lb-open'); openBtn!.focus(); });
      document.addEventListener('visibilitychange', () => { if (dlg?.open && document.visibilityState === 'visible') lock(); });
      document.addEventListener('recipe:scaled', () => { if (dlg?.open && !$('.ck-panel').hidden) syncIngredients(); });
    }
    openBtn.addEventListener('click', () => {
      if (typeof HTMLDialogElement === 'undefined') return;
      if (!dlg) build();
      show(0); lock();
      document.documentElement.classList.add('lb-open');
      dlg!.showModal();
    });
  }
</script>
