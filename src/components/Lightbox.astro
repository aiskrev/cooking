---
// Увеличаване на снимки: клик/докосване, стрелки, Esc, плъзгане, подписи.
// Без JavaScript връзките отварят оптимизирания файл в нов изглед.
---
<script>
  import { tc } from '../i18n/client';
  type Item = { el: HTMLAnchorElement; key: string };

  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('a[data-lightbox]'));
  const seen = new Set<string>();
  const items: Item[] = [];
  for (const el of links) {
    const key = el.dataset.key ?? el.href;
    if (seen.has(key)) continue;
    seen.add(key);
    items.push({ el, key });
  }
  const indexByKey = new Map(items.map((it, i) => [it.key, i]));

  let dialog: HTMLDialogElement | null = null;
  let stage: HTMLElement, caption: HTMLElement, count: HTMLElement, prevBtn: HTMLButtonElement, nextBtn: HTMLButtonElement;
  let current = 0;
  let opener: HTMLElement | null = null;

  function build() {
    dialog = document.createElement('dialog');
    dialog.className = 'lightbox';
    dialog.setAttribute('aria-label', tc('lightbox.label'));
    dialog.innerHTML = `
      <div class="lb-bar">
        <span class="lb-count" aria-live="polite"></span>
        <button type="button" class="lb-btn lb-close"></button>
      </div>
      <div class="lb-stage">
        <button type="button" class="lb-btn lb-nav lb-prev">‹</button>
        <div class="lb-picture"></div>
        <button type="button" class="lb-btn lb-nav lb-next">›</button>
      </div>
      <p class="lb-caption"></p>`;
    const closeBtn = dialog.querySelector('.lb-close') as HTMLElement;
    closeBtn.textContent = tc('lightbox.close'); closeBtn.setAttribute('aria-label', tc('lightbox.closeAria'));
    dialog.querySelector('.lb-prev')!.setAttribute('aria-label', tc('lightbox.prev'));
    dialog.querySelector('.lb-next')!.setAttribute('aria-label', tc('lightbox.next'));
    document.body.appendChild(dialog);
    stage = dialog.querySelector('.lb-picture')!;
    caption = dialog.querySelector('.lb-caption')!;
    count = dialog.querySelector('.lb-count')!;
    prevBtn = dialog.querySelector('.lb-prev')!;
    nextBtn = dialog.querySelector('.lb-next')!;
    dialog.querySelector('.lb-close')!.addEventListener('click', () => dialog!.close());
    prevBtn.addEventListener('click', () => show(current - 1));
    nextBtn.addEventListener('click', () => show(current + 1));
    // клик върху тъмния фон затваря
    dialog.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t === dialog || t.classList.contains('lb-stage') || t.classList.contains('lb-picture')) dialog!.close();
    });
    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('lb-open');
      stage.replaceChildren();
      opener?.focus();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(current - 1); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); show(current + 1); }
      else if (e.key === 'Home') { e.preventDefault(); show(0); }
      else if (e.key === 'End') { e.preventDefault(); show(items.length - 1); }
    });
    // плъзгане с пръст
    let startX = 0, startY = 0;
    stage.parentElement!.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; startY = e.touches[0].clientY; }, { passive: true });
    stage.parentElement!.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      const dy = e.changedTouches[0].clientY - startY;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) show(current + (dx < 0 ? 1 : -1));
    }, { passive: true });
  }

  function pictureFor(el: HTMLElement): HTMLPictureElement {
    const d = el.dataset;
    const pic = document.createElement('picture');
    const sizes = '100vw';
    for (const [type, srcset] of [['image/avif', d.avif], ['image/webp', d.webp]] as const) {
      if (!srcset) continue;
      const s = document.createElement('source');
      s.type = type; s.srcset = srcset; s.sizes = sizes;
      pic.appendChild(s);
    }
    const img = document.createElement('img');
    img.srcset = d.jpeg ?? '';
    img.sizes = sizes;
    img.src = (d.jpeg ?? '').split(' ')[0];
    img.alt = d.alt ?? '';
    if (d.w) img.width = Number(d.w);
    if (d.h) img.height = Number(d.h);
    img.decoding = 'async';
    pic.appendChild(img);
    return pic;
  }

  function preload(i: number) {
    const it = items[(i + items.length) % items.length];
    if (!it) return;
    const u = (it.el.dataset.webp ?? '').split(' ')[0];
    if (u) { const im = new Image(); im.src = u; }
  }

  function show(i: number) {
    current = (i + items.length) % items.length;
    const el = items[current].el;
    stage.replaceChildren(pictureFor(el));
    const text = el.dataset.caption || el.dataset.alt || '';
    caption.textContent = text;
    count.textContent = tc('lightbox.count', { n: current + 1, total: items.length });
    const single = items.length < 2;
    prevBtn.hidden = nextBtn.hidden = single;
    preload(current + 1); preload(current - 1);
  }

  function open(index: number, from: HTMLElement) {
    if (!dialog) build();
    opener = from;
    show(index);
    document.documentElement.classList.add('lb-open');
    if (!dialog!.open) dialog!.showModal();
  }

  for (const el of links) {
    el.addEventListener('click', (e) => {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      if (typeof HTMLDialogElement === 'undefined') return;
      const idx = indexByKey.get(el.dataset.key ?? el.href);
      if (idx === undefined) return;
      e.preventDefault();
      open(idx, el);
    });
  }

  document.querySelectorAll<HTMLButtonElement>('[data-print]').forEach((b) =>
    b.addEventListener('click', () => window.print()),
  );
</script>
