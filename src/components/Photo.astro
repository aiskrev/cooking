---
import { Picture } from 'astro:assets';
import type { Photo } from '../lib/recipes';
import { lightboxData, fitWidths } from '../lib/images';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  photo: Photo;
  sizes: string;
  widths?: number[];
  /** true само за главната снимка (LCP): без lazy, с висок приоритет */
  eager?: boolean;
  /** увеличаване по клик (лайтбокс) */
  zoom?: boolean;
  /** повторение на снимка, която вече е на страницата: само ключ към лайтбокса (без дублиране на данните) */
  lite?: boolean;
  /** името на връзката при alt="" (когато снимката е повторение и не бива да се чете втори път) */
  label?: string;
  class?: string;
}
const { locale, photo, sizes, widths = [480, 800, 1120], eager = false, zoom = false, lite = false, label, class: cls = '' } = Astro.props;
const max = photo.image.width;
const usable = fitWidths(widths, max);
const lb = zoom && !lite ? await lightboxData(photo) : null;
const alt = label ? '' : photo.alt;
const w = usable[usable.length - 1];
---
{zoom ? (
  <a
    class={`photo-link ${cls}`}
    href={lb?.href ?? '#'}
    data-lightbox
    data-key={photo.key}
    aria-label={label}
    data-alt={lb ? photo.alt : undefined}
    data-caption={lb ? (photo.caption ?? '') : undefined}
    data-avif={lb?.avif}
    data-webp={lb?.webp}
    data-jpeg={lb?.jpeg}
    data-w={lb?.width}
    data-h={lb?.height}
  >
    <span class="photo">
      <img class="lqip" src={photo.lqip} alt="" width="20" height="25" aria-hidden="true" />
      <Picture
        src={photo.image}
        alt={alt}
        widths={usable}
        sizes={sizes}
        formats={['avif', 'webp']}
        fallbackFormat="jpeg"
        loading={eager ? 'eager' : 'lazy'}
        decoding={eager ? 'sync' : 'async'}
        fetchpriority={eager ? 'high' : 'auto'}
        width={w}
      />
    </span>
    {!label && <span class="sr-only">{t(locale, 'photo.zoomHidden')}</span>}
  </a>
) : (
  <span class={`photo ${cls}`}>
    <img class="lqip" src={photo.lqip} alt="" width="20" height="25" aria-hidden="true" />
    <Picture
      src={photo.image}
      alt={photo.alt}
      widths={usable}
      sizes={sizes}
      formats={['avif', 'webp']}
      fallbackFormat="jpeg"
      loading={eager ? 'eager' : 'lazy'}
      decoding={eager ? 'sync' : 'async'}
      fetchpriority={eager ? 'high' : 'auto'}
      width={w}
    />
  </span>
)}
