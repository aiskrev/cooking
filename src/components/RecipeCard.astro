---
import type { Recipe } from '../lib/recipes';
import { getCoverPhoto } from '../lib/recipes';
import { formatMinutes } from '../lib/text';
import { collectionLabels } from '../site.config';
import Photo from './Photo.astro';
interface Props { recipe: Recipe; eager?: boolean; level?: 2 | 3; filterable?: boolean }
const { recipe, eager = false, level = 3, filterable = false } = Astro.props;
const Heading = level === 2 ? 'h2' : 'h3';
const cover = await getCoverPhoto(recipe);
const d = recipe.data;
const total = d.prepTime + d.cookTime + d.restTime;
const attrs = filterable
  ? {
      'data-card': '',
      'data-title': d.title.toLocaleLowerCase('bg'),
      'data-search': [d.title, d.description, d.category, d.tags.join(' '), d.method.join(' ')].join(' ').toLocaleLowerCase('bg'),
      'data-collection': d.collection,
      'data-category': d.category,
      'data-method': d.method.join('|'),
      'data-difficulty': d.difficulty ?? '',
      'data-time': String(total),
      'data-date': d.date.toISOString(),
    }
  : {};
---
<article class="card" {...attrs}>
  {cover && (
    <a class="card-media" href={`/recepti/${recipe.id}/`} tabindex="-1" aria-hidden="true">
      <Photo photo={cover} sizes="(min-width: 960px) 360px, (min-width: 600px) 45vw, 100vw" widths={[480, 800]} eager={eager} class="card-photo" />
    </a>
  )}
  <div class="card-body">
    <p class="card-meta">
      <span>{d.category}</span><span aria-hidden="true">·</span><span>{formatMinutes(total)}</span>
      {d.difficulty && <><span aria-hidden="true">·</span><span>{d.difficulty}</span></>}
    </p>
    <Heading class="card-title"><a href={`/recepti/${recipe.id}/`}>{d.title}</a></Heading>
    <p class="card-desc">{d.description}</p>
    <p class="card-foot">
      <span class="tag-soft">{d.collection === 'fine-dining' ? 'Фино ядене' : 'Традиционна'}</span>
      {d.review && <span class="tag-soft draft">Чернова</span>}
    </p>
  </div>
</article>
