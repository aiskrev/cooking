---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Carousel from '../components/Carousel.astro';
import Lightbox from '../components/Lightbox.astro';
import RecipeCard from '../components/RecipeCard.astro';
import RecipeTools from '../components/RecipeTools.astro';
import Community from '../components/Community.astro';
import { getRecipes, getPhotos, getRelated, categoryName, type Photo as PhotoT, type Recipe } from '../lib/recipes';
import { ogImage, schemaImages, stepImageUrl, thumbUrl } from '../lib/images';
import { isoDuration, slugify } from '../lib/text';
import { siteText, site } from '../site.config';
import { href, t, tn, formatMinutes, formatDate, portionsLabel, localeInfo, termLabel, type Locale } from '../i18n';
import { ingredientLine, type Ing } from '../i18n/ingredients';

interface Props { locale: Locale; recipe: Recipe; all: Recipe[]; otherRecipe?: Recipe }
const { locale, recipe, all, otherRecipe } = Astro.props;
const d = recipe.data;
const text = siteText[locale];
const { Content } = await render(recipe.entry);
const photos = await getPhotos(recipe);
const allPhotos = [...photos.values()];
const cover: PhotoT | undefined = d.cover ? photos.get(d.cover) : allPhotos[0];
const total = d.prepTime + d.cookTime + d.restTime;
const url = new URL(Astro.url.pathname, Astro.site).href;
const statusKey = recipe.bg.status;

// ---- Фото-история (до 10 кадъра по реда на готвенето) ----
const stepPhotoFiles = d.steps.flatMap((s) => (s.photo ? [s.photo] : []));
let storyFiles = d.carousel ?? [...new Set(stepPhotoFiles)];
if (storyFiles.length > 10) {
  storyFiles = Array.from({ length: 10 }, (_, i) => storyFiles[Math.round((i * (storyFiles.length - 1)) / 9)]);
}
const storyPhotos = storyFiles.map((f) => photos.get(f)).filter((p): p is PhotoT => !!p);
const showStory = storyPhotos.length >= 5;

// Данни за лайтбокса се изписват само при първото появяване на снимка в страницата
const rendered = new Set<string>();
const first = (p: PhotoT) => { const lite = rendered.has(p.key); rendered.add(p.key); return { photo: p, lite }; };
const heroItem = cover ? first(cover) : undefined;
const storyItems = showStory ? storyPhotos.map(first) : [];

const usedSet = new Set([...stepPhotoFiles, cover?.file, ...storyPhotos.map((p) => p.file)]);
const extras = allPhotos.filter((p) => !usedSet.has(p.file));
const extraGroups = new Map<string, PhotoT[]>();
for (const p of extras) {
  const g = d.photos[p.file]?.session ?? t(locale, 'recipe.extraShots');
  extraGroups.set(g, [...(extraGroups.get(g) ?? []), p]);
}

// ---- Съставки ----
const toIngs = (r: Recipe) =>
  r.data.ingredients.map((g) => ({
    title: g.title,
    items: g.items.map((it): Ing => (typeof it === 'string' ? { n: it, s: false } : { a: it.amount, u: it.unit, n: it.name, o: it.note, s: it.scale && !!it.amount })),
  }));
const ingGroups = toIngs(recipe);
const canScale = ingGroups.some((g) => g.items.some((i) => i.s));
const flat = (r: Recipe) => toIngs(r).flatMap((g) => g.items);
// И двата езика (ако превод съществува) – за списъка за пазаруване, който показва избрания език
const ingData = {
  titles: { [locale]: d.title, ...(otherRecipe ? { [otherRecipe.locale]: otherRecipe.data.title } : {}) },
  lines: { [locale]: flat(recipe), ...(otherRecipe ? { [otherRecipe.locale]: flat(otherRecipe) } : {}) },
};

// ---- Структурирани данни (само реални стойности) ----
const og = cover ? await ogImage(cover, Astro.site) : undefined;
const thumb = cover ? await thumbUrl(cover) : undefined;
const ldImages = cover ? await schemaImages(cover, Astro.site) : [];
const ldSteps = await Promise.all(
  d.steps.map(async (s, i) => {
    const p = s.photo ? photos.get(s.photo) : undefined;
    return {
      '@type': 'HowToStep',
      name: s.title ?? t(locale, 'recipe.step', { n: i + 1 }),
      text: s.text,
      url: `${url}#stapka-${i + 1}`,
      ...(p ? { image: await stepImageUrl(p, Astro.site) } : {}),
    };
  }),
);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Recipe',
  name: d.title,
  description: d.description,
  inLanguage: localeInfo[locale].lang,
  url,
  mainEntityOfPage: url,
  author: { '@type': 'Organization', name: site.author },
  datePublished: d.date.toISOString().slice(0, 10),
  ...(d.updated ? { dateModified: d.updated.toISOString().slice(0, 10) } : {}),
  ...(ldImages.length ? { image: ldImages } : {}),
  prepTime: isoDuration(d.prepTime),
  cookTime: isoDuration(d.cookTime),
  totalTime: isoDuration(total),
  recipeYield: [String(d.servings), portionsLabel(locale, d.servings)],
  recipeCategory: d.category,
  ...(d.cuisine ? { recipeCuisine: d.cuisine } : {}),
  ...(d.tags.length ? { keywords: d.tags.join(', ') } : {}),
  recipeIngredient: ingGroups.flatMap((g) => g.items.map((i) => ingredientLine(locale, i))),
  recipeInstructions: ldSteps,
};
const crumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t(locale, 'breadcrumb.home'), item: new URL(href(locale), Astro.site).href },
    { '@type': 'ListItem', position: 2, name: t(locale, 'recipe.crumbRecipes'), item: new URL(href(locale, 'recipes'), Astro.site).href },
    { '@type': 'ListItem', position: 3, name: d.title },
  ],
};
const related = getRelated(recipe, all, 3);
const cookData = d.steps.map((s, i) => ({ n: i + 1, title: s.title ?? '', text: s.text, why: s.why ?? '', cue: s.cue ?? '', avoid: s.avoid ?? '', time: s.time ?? 0 }));
const chef = [
  d.technique && { h: t(locale, 'recipe.technique'), t: d.technique },
  d.temperature && { h: t(locale, 'recipe.temperature'), t: d.temperature },
  d.balance && { h: t(locale, 'recipe.balance'), t: d.balance },
].filter(Boolean) as { h: string; t: string }[];
const catName = categoryName(locale, recipe);
const alt = { bg: href('bg', 'recipes', recipe.id), ...(locale === 'en' || otherRecipe ? { en: href('en', 'recipes', recipe.id) } : {}) };
const showNote = locale === 'en' && recipe.translation && !recipe.translation.reviewed;
---
<Base
  locale={locale}
  title={d.title}
  description={d.description}
  type="article"
  image={og && cover ? { ...og, alt: cover.alt } : undefined}
  jsonLd={[jsonLd, crumbs]}
  published={d.date}
  modified={d.updated}
  alt={alt}
  fallback={href(locale === 'bg' ? 'en' : 'bg', 'recipes')}
>
  <article class="wrap recipe" data-pagefind-body data-recipe data-base-servings={d.servings}>
    <span hidden data-pagefind-filter="category[data-v]" data-v={d.category}></span>
    {d.difficulty && <span hidden data-pagefind-filter="difficulty[data-v]" data-v={d.difficulty}></span>}
    {d.cuisine && <span hidden data-pagefind-filter="cuisine[data-v]" data-v={d.cuisine}></span>}
    {d.method.map((m) => <span hidden data-pagefind-filter="method[data-v]" data-v={m}></span>)}
    {d.tags.map((tg) => <span hidden data-pagefind-filter="tag[data-v]" data-v={tg}></span>)}
    <span hidden data-pagefind-filter="time[data-v]" data-v={t(locale, total <= 30 ? 'search.time.1' : total <= 60 ? 'search.time.2' : total <= 120 ? 'search.time.3' : 'search.time.4')}></span>
    <span hidden data-pagefind-meta="time[data-v]" data-v={formatMinutes(locale, total)}></span>
    <span hidden data-pagefind-meta="category[data-v]" data-v={d.category}></span>
    {d.difficulty && <span hidden data-pagefind-meta="difficulty[data-v]" data-v={d.difficulty}></span>}
    <span hidden data-pagefind-sort="title[data-v]" data-v={d.title}></span>
    {thumb && <span hidden data-pagefind-meta="image[data-src]" data-src={thumb}></span>}
    <nav class="breadcrumb" aria-label={t(locale, 'breadcrumb.label')}>
      <ol>
        <li><a href={href(locale)}>{t(locale, 'breadcrumb.home')}</a></li>
        <li><a href={href(locale, 'recipes')}>{t(locale, 'recipe.crumbRecipes')}</a></li>
        <li aria-current="page">{d.title}</li>
      </ol>
    </nav>

    {d.review && (
      <div class="notice" role="note">
        <strong>{t(locale, `status.${statusKey}` as any)}</strong>
        <p>{t(locale, `status.${statusKey}.text` as any)}</p>
      </div>
    )}

    <header class="recipe-head">
      <div>
        <p class="eyebrow">{t(locale, `collection.${recipe.bg.collection}.name` as any)}</p>
        <h1>{d.title}</h1>
        <p class="lead">{d.description}</p>
        {d.intro && <p class="intro">{d.intro}</p>}
        <dl class="facts">
          <div><dt>{t(locale, 'recipe.prep')}</dt><dd>{formatMinutes(locale, d.prepTime)}</dd></div>
          <div><dt>{t(locale, 'recipe.cook')}</dt><dd>{formatMinutes(locale, d.cookTime)}</dd></div>
          {d.restTime > 0 && <div><dt>{t(locale, 'recipe.rest')}</dt><dd>{formatMinutes(locale, d.restTime)}</dd></div>}
          <div><dt>{t(locale, 'recipe.total')}</dt><dd>{formatMinutes(locale, total)}</dd></div>
          <div><dt>{t(locale, 'recipe.servings')}</dt><dd>{d.servings}</dd></div>
          {d.difficulty && <div><dt>{t(locale, 'recipe.difficulty')}</dt><dd>{d.difficulty}</dd></div>}
        </dl>
        <p class="muted meta-line">
          <a href={href(locale, 'categories', slugify(catName))}>{d.category}</a>
          {d.method.length > 0 && <> · {d.method.join(', ')}</>}
          {d.cuisine && <> · {d.cuisine}</>}
          · <time datetime={d.date.toISOString().slice(0, 10)}>{formatDate(locale, d.date)}</time>
        </p>
        <p class="rating-line" data-rating-line data-slug={recipe.id} hidden></p>
        <div class="actions">
          <a class="btn" href="#sastavki">{t(locale, 'recipe.toIngredients')}</a>
          <button type="button" class="btn secondary" data-cook-open>{t(locale, 'recipe.cookMode')}</button>
          <button type="button" class="btn secondary" data-fav-toggle aria-pressed="false">{t(locale, 'favorites.add')}</button>
          <button type="button" class="btn secondary" data-cooked-toggle aria-pressed="false">{t(locale, 'recipe.cooked')}</button>
          <button type="button" class="btn secondary" data-print>{t(locale, 'recipe.print')}</button>
          <button type="button" class="btn secondary" data-share data-share-title={d.title}>{t(locale, 'recipe.share')}</button>
        </div>
        <p class="muted small" data-cooked-count hidden></p>
        <p class="small" role="status" aria-live="polite" data-actions-status></p>
      </div>
      {heroItem && (
        <figure class="hero-fig">
          <Photo photo={heroItem.photo} locale={locale} lite={heroItem.lite} zoom eager class="hero-photo" sizes="(min-width: 1280px) 560px, (min-width: 900px) 44vw, calc(100vw - 32px)" widths={[480, 800, 1120]} />
          {d.illustrative && <p class="photo-note"><span class="badge">{t(locale, 'recipe.illustrative')}</span></p>}
        </figure>
      )}
    </header>

    {d.illustrative && (
      <div class="notice illustrative" role="note">
        <strong>{t(locale, 'recipe.illustrative')}</strong>
        <p>{t(locale, 'recipe.illustrativeText')}</p>
      </div>
    )}

    {showNote && <p class="notice small-notice" role="note">{t(locale, 'recipe.translationNote')}</p>}

    <nav class="page-nav" aria-label={t(locale, 'recipe.pageNav')}>
      <ul>
        <li><a href="#sastavki">{t(locale, 'recipe.navIngredients')}</a></li>
        <li><a href="#prigotvyane">{t(locale, 'recipe.navMethod')}</a></li>
        {(showStory || extras.length > 0) && <li><a href="#snimki">{t(locale, 'recipe.navPhotos')}</a></li>}
        <li><a href="#ocenki">{t(locale, 'recipe.navRatings')}</a></li>
        <li><a href="#komentari">{t(locale, 'recipe.navComments')}</a></li>
      </ul>
    </nav>

    {showStory && <div id="snimki"><Carousel locale={locale} items={storyItems} title={d.title} /></div>}

    <div class="recipe-grid">
      <section class="ingredients" id="sastavki" aria-labelledby="h-sastavki">
        <h2 id="h-sastavki">{t(locale, 'recipe.ingredients')}</h2>
        <RecipeTools locale={locale} servings={d.servings} canScale={canScale} />
        {ingGroups.map((g) => (
          <>
            {g.title && <h3>{g.title}</h3>}
            <ul class="ing-list">
              {g.items.map((i) => (
                <li data-ing data-scale={i.s ? 'y' : 'n'}>
                  <label>
                    <input type="checkbox" class="ing-check" />
                    <span class="ing-text">{ingredientLine(locale, i)}</span>
                  </label>
                </li>
              ))}
            </ul>
          </>
        ))}
        {canScale && <p class="muted small">{t(locale, 'recipe.scaleNote')}</p>}
        {d.mise.length > 0 && (
          <div class="mise">
            <h3>{t(locale, 'recipe.mise')}</h3>
            <ul>{d.mise.map((m) => <li>{m}</li>)}</ul>
          </div>
        )}
      </section>

      <section aria-labelledby="h-prigotvyane" class="method" id="prigotvyane">
        <h2 id="h-prigotvyane">{t(locale, 'recipe.method')}</h2>
        <ol class="steps" data-reveal-group>
          {d.steps.map((s, i) => {
            const p = s.photo ? photos.get(s.photo) : undefined;
            const item = p ? first(p) : undefined;
            return (
              <li class="step" id={`stapka-${i + 1}`} data-step>
                <div class="step-body">
                  {s.title && <h3>{s.title}{s.time && <span class="step-time"> · {formatMinutes(locale, s.time)}</span>}</h3>}
                  <p class="step-text">{s.text}</p>
                  {s.why && <p class="step-note"><strong>{t(locale, 'recipe.why')}</strong> {s.why}</p>}
                  {s.cue && <p class="step-note"><strong>{t(locale, 'recipe.cue')}</strong> {s.cue}</p>}
                  {s.avoid && <p class="step-note avoid"><strong>{t(locale, 'recipe.avoid')}</strong> {s.avoid}</p>}
                </div>
                {item && (
                  <figure class="step-photo">
                    <Photo photo={item.photo} locale={locale} lite={item.lite} zoom sizes="(min-width: 640px) 416px, calc(100vw - 32px)" widths={[480, 800]} />
                    {item.photo.caption && <figcaption>{item.photo.caption}</figcaption>}
                  </figure>
                )}
              </li>
            );
          })}
        </ol>
      </section>
    </div>

    {chef.length > 0 && (
      <section class="chef" aria-labelledby="h-chef" data-reveal>
        <h2 id="h-chef">{t(locale, 'recipe.chef')}</h2>
        <div class="chef-grid">
          {chef.map((c) => (
            <div class="chef-card"><h3>{c.h}</h3><p>{c.t}</p></div>
          ))}
        </div>
      </section>
    )}

    {(d.tips.length > 0 || d.mistakes.length > 0 || d.substitutions.length > 0) && (
      <section class="advice" aria-labelledby="h-tips" data-reveal>
        <h2 id="h-tips">{t(locale, 'recipe.advice')}</h2>
        <div class="chef-grid">
          {d.tips.length > 0 && <div class="chef-card"><h3>{t(locale, 'recipe.tips')}</h3><ul>{d.tips.map((x) => <li>{x}</li>)}</ul></div>}
          {d.mistakes.length > 0 && <div class="chef-card"><h3>{t(locale, 'recipe.mistakes')}</h3><ul>{d.mistakes.map((x) => <li>{x}</li>)}</ul></div>}
          {d.substitutions.length > 0 && <div class="chef-card"><h3>{t(locale, 'recipe.substitutions')}</h3><ul>{d.substitutions.map((x) => <li>{x}</li>)}</ul></div>}
        </div>
      </section>
    )}

    {(d.plating || d.serving || d.storage) && (
      <section class="serve" aria-labelledby="h-serve" data-reveal>
        <h2 id="h-serve">{t(locale, 'recipe.serve')}</h2>
        <dl class="serve-list">
          {d.plating && <div><dt>{t(locale, 'recipe.plating')}</dt><dd>{d.plating}</dd></div>}
          {d.serving && <div><dt>{t(locale, 'recipe.serving')}</dt><dd>{d.serving}</dd></div>}
          {d.storage && <div><dt>{t(locale, 'recipe.storage')}</dt><dd>{d.storage}</dd></div>}
        </dl>
      </section>
    )}

    {d.context && <p class="notice small-notice" role="note"><strong>{t(locale, 'recipe.note')}</strong> {d.context}</p>}

    <section class="notes-md" aria-label={t(locale, 'recipe.notes')}><Content /></section>

    {d.allergens.length > 0 && (
      <p class="allergens"><strong>{t(locale, 'recipe.allergens')}</strong> {d.allergens.join(', ')}.</p>
    )}

    {extras.length > 0 && (
      <section class="more-photos" aria-labelledby="h-more" id={showStory ? undefined : 'snimki'}>
        <h2 id="h-more">{t(locale, 'recipe.morePhotos')} <span class="count">({extras.length})</span></h2>
        {[...extraGroups.entries()].map(([group, list]) => (
          <>
            <h3 class="session">{group}</h3>
            <ul class="thumbs" data-reveal-group>
              {list.map((p) => {
                const it = first(p);
                return <li><Photo photo={it.photo} locale={locale} lite={it.lite} zoom label={p.caption ?? p.alt} widths={[480]} sizes="(min-width: 640px) 160px, 45vw" /></li>;
              })}
            </ul>
          </>
        ))}
      </section>
    )}

    {d.tags.length > 0 && (
      <section class="tags" aria-labelledby="h-tags">
        <h2 id="h-tags">{t(locale, 'recipe.tagsHeading')}</h2>
        <ul class="chips">
          {d.tags.map((tg, i) => <li><a href={href(locale, 'tags', slugify(termLabel(locale, 'tag', recipe.bg.tags[i]) ?? tg))}>{tg}</a></li>)}
        </ul>
      </section>
    )}

    <p class="print-only">{t(locale, 'recipe.printFrom', { name: text.name, url })}</p>
  </article>

  {related.length > 0 && (
    <section class="wrap related" aria-labelledby="h-related">
      <h2 id="h-related">{t(locale, 'recipe.related')}</h2>
      <ul class="grid" data-reveal-group>
        {related.map((r) => <li><RecipeCard recipe={r} locale={locale} level={3} /></li>)}
      </ul>
    </section>
  )}

  <Community locale={locale} slug={recipe.id} title={d.title} />

  <script type="application/json" id="cook-data" set:html={JSON.stringify({ title: d.title, steps: cookData })} />
  <script type="application/json" id="ing-data" set:html={JSON.stringify(ingData)} />
  <Lightbox />
</Base>
