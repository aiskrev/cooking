---
import Base from '../layouts/Base.astro';
import RecipeCard from '../components/RecipeCard.astro';
import RecipeFeature from '../components/RecipeFeature.astro';
import CategoryTiles from '../components/CategoryTiles.astro';
import Photo from '../components/Photo.astro';
import { getRecipes, getCategories, getPhotos, getCoverPhoto } from '../lib/recipes';
import { ogImage } from '../lib/images';
import { siteText } from '../site.config';
import { href, t, localeInfo, type Locale } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const text = siteText[locale];
const recipes = await getRecipes(locale);
const categories = getCategories(recipes, locale);
const featured = recipes.filter((r) => r.bg.featured).slice(0, 6);
const traditional = recipes.filter((r) => r.bg.collection === 'traditional' && !r.bg.featured).slice(0, 6);
const fine = recipes.filter((r) => r.bg.collection === 'fine-dining').slice(0, 6);
const shownIds = new Set([...featured, ...traditional, ...fine].map((r) => r.id));
const latest = [...recipes].filter((r) => !shownIds.has(r.id)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf() || a.data.title.localeCompare(b.data.title, localeInfo[locale].intl)).slice(0, 6);
// Традиционната кухня: две рецепти като редакционни акценти (снимка/текст, редуват се), останалите – в мрежа
const tradFeatures = traditional.slice(0, 2);
const tradRest = traditional.slice(2);

// Заглавен кадър: завършено ястие от избрана рецепта (ако липсва – първата с корица)
const heroRecipe = recipes.find((r) => r.id === 'banitsa-sas-sirene') ?? featured[0] ?? recipes[0];
const heroPhoto = heroRecipe ? await getCoverPhoto(heroRecipe) : undefined;
const og = heroPhoto ? await ogImage(heroPhoto, Astro.site) : undefined;

// Фотографско пътешествие: всички кадри на една рецепта по реда на приготвяне
const journeyRecipe = recipes.find((r) => r.id === 'beef-wellington') ?? recipes.find((r) => r.data.steps.filter((s) => s.photo).length >= 6);
const journeyPhotos = journeyRecipe ? await getPhotos(journeyRecipe) : new Map();
const journey = journeyRecipe ? journeyRecipe.data.steps.flatMap((s, i) => (s.photo ? [{ photo: journeyPhotos.get(s.photo)!, step: s.title ?? '', n: i + 1 }] : [])).slice(0, 8) : [];

const searchUrl = new URL(href(locale, 'search') + '?q={search_term_string}', Astro.site).href.replace('%7Bsearch_term_string%7D', '{search_term_string}');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: text.name,
  url: new URL(href(locale), Astro.site).href,
  inLanguage: localeInfo[locale].lang,
  potentialAction: {
    '@type': 'SearchAction',
    target: searchUrl,
    'query-input': 'required name=search_term_string',
  },
};
const stats = t(locale, 'home.stats', { recipes: `<strong>${recipes.length}</strong>`, categories: `<strong>${categories.length}</strong>` });
// Заглавието се показва дума по дума (анимация при зареждане); интервалите остават истински текст
const words = text.name.split(' ');
---
<Base locale={locale} home title={text.name} description={text.description} image={og} jsonLd={jsonLd} alt={{ bg: href('bg'), en: href('en') }}>
  <section class="home-hero" aria-labelledby="h-hero" data-hero>
    <div class="wrap home-hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{t(locale, 'home.eyebrow')}</p>
        <h1 id="h-hero" class="hero-title">{words.map((w, i) => <>{i > 0 && ' '}<span class="w">{w}</span></>)}</h1>
        <p class="hero-tagline">{text.tagline}</p>
        <p class="lead">{text.description}</p>
        <div class="actions">
          <a class="btn" href={href(locale, 'recipes')}>{t(locale, 'home.allRecipes')} <span class="btn-arrow" aria-hidden="true">→</span></a>
          <a class="btn secondary" href={href(locale, 'search')}>{t(locale, 'home.search')}</a>
        </div>
        <p class="stat-line" set:html={stats} />
      </div>
      {heroPhoto && heroRecipe && (
        <a class="hero-media" href={href(locale, 'recipes', heroRecipe.id)}>
          <span class="hero-frame">
            <Photo photo={heroPhoto} locale={locale} eager sizes="(min-width: 1280px) 560px, (min-width: 900px) 42vw, calc(100vw - 32px)" widths={[480, 800, 1120]} />
            <span class="hero-caption">{heroRecipe.data.title}<small>{t(locale, 'home.heroNote')}</small></span>
          </span>
        </a>
      )}
    </div>
    <span class="hero-cue" aria-hidden="true"></span>
  </section>

  {featured.length > 0 && (
    <section class="section wrap" aria-labelledby="h-feat">
      <div class="section-head" data-reveal><h2 id="h-feat" class="h-display">{t(locale, 'home.featured')}</h2><a class="more-link" href={href(locale, 'recipes')}>{t(locale, 'home.allLink')}</a></div>
      <ul class="grid editorial" data-reveal-group>{featured.map((r) => <li><RecipeCard recipe={r} locale={locale} /></li>)}</ul>
    </section>
  )}

  {categories.length > 0 && (
    <section class="section wrap" aria-labelledby="h-cats">
      <div class="section-head" data-reveal><h2 id="h-cats" class="h-display">{t(locale, 'home.byType')}</h2><a class="more-link" href={href(locale, 'categories')}>{t(locale, 'nav.categories')} <span class="btn-arrow" aria-hidden="true">→</span></a></div>
      <CategoryTiles locale={locale} categories={categories} />
    </section>
  )}

  {traditional.length > 0 && (
    <section class="band band-warm" aria-labelledby="h-trad">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <div><p class="eyebrow">{t(locale, 'collection.traditional.short')}</p><h2 id="h-trad" class="h-display">{t(locale, 'collection.traditional.name')}</h2><p class="muted">{t(locale, 'collection.traditional.description')}</p></div>
          <a class="more-link" href={`${href(locale, 'recipes')}?collection=traditional`}>{t(locale, 'home.allTraditional')}</a>
        </div>
        <div class="features">
          {tradFeatures.map((r, i) => <RecipeFeature recipe={r} locale={locale} reverse={i % 2 === 1} index={i + 1} />)}
        </div>
        {tradRest.length > 0 && <ul class="grid" data-reveal-group>{tradRest.map((r) => <li><RecipeCard recipe={r} locale={locale} /></li>)}</ul>}
      </div>
    </section>
  )}

  {fine.length > 0 && (
    <section class="band band-dark rail" aria-labelledby="h-fine" data-rail>
      <div class="wrap">
        <div class="rail-head" data-reveal>
          <div class="section-head">
            <div><p class="eyebrow">{t(locale, 'collection.fine-dining.short')}</p><h2 id="h-fine" class="h-display">{t(locale, 'collection.fine-dining.name')}</h2><p class="muted">{t(locale, 'collection.fine-dining.description')}</p></div>
          </div>
          <div class="rail-nav">
            <a class="more-link" href={`${href(locale, 'recipes')}?collection=fine-dining`}>{t(locale, 'home.allFine')}</a>
            <button type="button" class="round-btn" data-rail-prev aria-label={t(locale, 'rail.prev')}><span aria-hidden="true">←</span></button>
            <button type="button" class="round-btn" data-rail-next aria-label={t(locale, 'rail.next')}><span aria-hidden="true">→</span></button>
          </div>
        </div>
        <ul class="rail-track" data-rail-track data-reveal>{fine.map((r) => <li><RecipeCard recipe={r} locale={locale} /></li>)}</ul>
      </div>
    </section>
  )}

  {journeyRecipe && journey.length >= 6 && (
    <section class="journey" aria-labelledby="h-journey" data-journey>
      <div class="journey-sticky">
        <div class="wrap section-head">
          <div><p class="eyebrow">{t(locale, 'story.title')}</p><h2 id="h-journey" class="h-display">{t(locale, 'home.journey')}</h2><p class="muted">{t(locale, 'home.journeyFrom', { title: journeyRecipe.data.title })}</p></div>
          <a class="more-link" href={href(locale, 'recipes', journeyRecipe.id)}>{t(locale, 'home.toRecipe')}</a>
        </div>
        <div class="journey-viewport" data-journey-viewport>
          <ol class="journey-track" data-journey-track>
            {journey.map((j, i) => (
              <li class="journey-item">
                {/* Името на връзката е „Стъпка N: заглавие“ (скрит текст); видимият номер и заглавие са същото съдържание, затова са скрити за екранните четци */}
                <a href={`${href(locale, 'recipes', journeyRecipe.id)}#stapka-${j.n}`}>
                  <Photo photo={{ ...j.photo, alt: '' }} locale={locale} sizes="(min-width: 1024px) 304px, 58vw" widths={[480, 800]} />
                  <span class="sr-only">{t(locale, 'home.stepAria', { n: j.n, title: j.step })}</span>
                  <span class="journey-cap" aria-hidden="true"><span class="journey-no">{String(j.n).padStart(2, '0')}</span><span class="journey-step">{j.step}</span></span>
                </a>
              </li>
            ))}
          </ol>
        </div>
        <div class="wrap"><div class="journey-progress" aria-hidden="true"><span></span></div></div>
      </div>
    </section>
  )}

  <section class="section wrap" aria-labelledby="h-new">
    <div class="section-head" data-reveal><h2 id="h-new" class="h-display">{t(locale, 'home.more')}</h2></div>
    <ul class="grid" data-reveal-group>{latest.map((r) => <li><RecipeCard recipe={r} locale={locale} /></li>)}</ul>
    <p class="center-cta"><a class="btn" href={href(locale, 'recipes')}>{t(locale, 'home.allN', { n: recipes.length })} <span class="btn-arrow" aria-hidden="true">→</span></a></p>
  </section>
</Base>
