---
// Любими рецепти. Гост: списъкът е само в браузъра (localStorage), без регистрация – както досега.
// Влязъл потребител: списъкът е в профила (/api/account/favorites); любимите от браузъра се сливат при входа (само добавяне).
// Ключът е стабилният идентификатор на рецептата – любимите се запазват при смяна на езика. Страницата съдържа всички рецепти скрити и показва избраните.
import Base from '../layouts/Base.astro';
import RecipeCard from '../components/RecipeCard.astro';
import { getRecipes } from '../lib/recipes';
import { href, t, type Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const recipes = await getRecipes(locale);
---
<Base locale={locale} title={t(locale, 'favorites.title')} description={t(locale, 'favorites.description')} noindex alt={{ bg: href('bg', 'favorites'), en: href('en', 'favorites') }}>
  <div class="wrap">
    <div class="page-head">
      <h1>{t(locale, 'favorites.title')}</h1>
      <p class="muted" data-fav-lead>{t(locale, 'favorites.lead')}</p>
    </div>
    <p class="small" role="status" aria-live="polite" data-fav-status></p>
    <p class="empty" data-fav-empty hidden>{t(locale, 'favorites.empty')}</p>
    <ul class="grid section" data-fav-grid>
      {recipes.map((r) => <li data-fav-item hidden><RecipeCard recipe={r} locale={locale} level={2} /></li>)}
    </ul>
    <noscript><p class="muted">{t(locale, 'favorites.noscript')}</p></noscript>
  </div>
</Base>

<script>
  import { tc } from '../i18n/client';
  import { api, getMe, localFavorites, setLocalFavorites } from '../scripts/account';
  const grid = document.querySelector<HTMLElement>('[data-fav-grid]')!;
  const empty = document.querySelector<HTMLElement>('[data-fav-empty]')!;
  const status = document.querySelector<HTMLElement>('[data-fav-status]')!;
  let member = false;
  let server: string[] = [];
  const current = () => new Set(member ? server : localFavorites());

  // Кратко „изчезване“ на картата преди премахването (без него при намалено движение)
  const leave = (li: HTMLElement) => new Promise<void>((done) => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return done();
    li.classList.add('is-leaving');
    window.setTimeout(() => { li.classList.remove('is-leaving'); done(); }, 220);
  });

  async function remove(slug: string, li: HTMLElement) {
    await leave(li);
    if (!member) { setLocalFavorites(localFavorites().filter((x) => x !== slug)); render(); return; }
    const before = server;
    server = server.filter((x) => x !== slug); render(); // оптимистично
    try { await api(`/api/account/favorites/${slug}`, 'DELETE'); }
    catch { server = before; render(); status.textContent = tc('favorites.error'); li.querySelector<HTMLElement>('.fav-remove')?.focus(); }
  }

  function render() {
    const favs = current();
    let shown = 0;
    grid.querySelectorAll<HTMLElement>('[data-fav-item]').forEach((li) => {
      const slug = li.querySelector<HTMLElement>('[data-slug]')?.dataset.slug ?? '';
      const on = favs.has(slug);
      li.hidden = !on;
      if (on) shown++;
      if (on && !li.querySelector('.fav-remove')) {
        const b = document.createElement('button');
        b.type = 'button'; b.className = 'btn secondary small fav-remove'; b.textContent = tc('favorites.remove');
        b.addEventListener('click', () => remove(slug, li));
        li.querySelector('.card-body')?.append(b);
      }
    });
    empty.hidden = shown > 0;
  }
  render();

  getMe().then(async (r) => {
    if (!r.user) return;
    try {
      const { favorites } = await api<{ favorites: { slug: string }[] }>('/api/account/favorites');
      member = true; server = favorites.map((f) => f.slug);
      document.querySelector<HTMLElement>('[data-fav-lead]')!.textContent = tc('favorites.leadMember');
      render();
    } catch { /* остава списъкът от браузъра */ }
  });
</script>
