---
import '../styles/global.css';
import { site } from '../site.config';

interface Props {
  title: string;
  description: string;
  /** абсолютен адрес на картинка за Open Graph */
  image?: { url: string; width: number; height: number; alt?: string };
  type?: 'website' | 'article';
  jsonLd?: object | object[];
  noindex?: boolean;
  published?: Date;
  modified?: Date;
}
const { title, description, image, type = 'website', jsonLd, noindex = false, published, modified } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = Astro.url.pathname === '/' ? `${site.name} – ${site.tagline}` : `${title} | ${site.name}`;
const robots = noindex || site.noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
const nav = [
  { href: '/recepti/', label: 'Рецепти' },
  { href: '/kategorii/', label: 'Категории' },
  { href: '/tursene/', label: 'Търсене' },
  { href: '/spisak/', label: 'Списък' },
  { href: '/lyubimi/', label: 'Любими' },
];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} – RSS`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/lora-cyrillic-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-sans-3-cyrillic-wght-normal.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    {image && <meta property="og:image" content={image.url} />}
    {image && <meta property="og:image:width" content={String(image.width)} />}
    {image && <meta property="og:image:height" content={String(image.height)} />}
    {image?.alt && <meta property="og:image:alt" content={image.alt} />}
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image.url} />}

    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Към съдържанието</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href="/" aria-label={`${site.name} – начална страница`}>
          <svg aria-hidden="true" width="26" height="26" viewBox="0 0 32 32"><path fill="currentColor" d="M16 3c-5 0-9 3.6-9 8.2 0 2.5 1.2 4.6 3 6V25a4 4 0 0 0 4 4h4a4 4 0 0 0 4-4v-7.8c1.8-1.4 3-3.5 3-6C25 6.600 21 3 16 3Z"/></svg>
          <span>{site.name}</span>
        </a>
        <nav class="main-nav" aria-label="Основно меню">
          <ul>
            {nav.map((n) => (
              <li><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
        <button type="button" class="theme-toggle" data-theme-toggle aria-pressed="false">
          Тъмна тема
        </button>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <p>© {new Date().getFullYear()} {site.copyrightHolder}</p>
        <p><a href="/rss.xml">RSS</a> · <a href="/sitemap-index.xml">Карта на сайта</a></p>
        <p class="muted">Сайтът не използва бисквитки за проследяване. Темата (светла/тъмна) се пази само в браузъра ви.</p>
      </div>
    </footer>
    <script>
      import '../scripts/summary';
    </script>
    <script>
      const root = document.documentElement;
      const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      const mq = window.matchMedia('(prefers-color-scheme: dark)');
      const current = () => root.dataset.theme ?? (mq.matches ? 'dark' : 'light');
      const sync = () => {
        const dark = current() === 'dark';
        btn?.setAttribute('aria-pressed', String(dark));

      };
      btn?.addEventListener('click', () => {
        const next = current() === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
        sync();
      });
      sync();
    </script>
  </body>
</html>
