---
import '../styles/global.css';
import { site, siteText, copyrightHolder } from '../site.config';
import { locales, localeInfo, otherLocale, href, t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** абсолютен адрес на картинка за Open Graph */
  image?: { url: string; width: number; height: number; alt?: string };
  type?: 'website' | 'article';
  jsonLd?: object | object[];
  noindex?: boolean;
  published?: Date;
  modified?: Date;
  /** Пътища на ИСТИНСКИТЕ еквиваленти на тази страница по езици (само публикувани). От тях се правят hreflang и превключвателят. */
  alt?: Partial<Record<Locale, string>>;
  /** Къде да води превключвателят, когато няма еквивалент на другия език (по подразбиране – началото на другия език) */
  fallback?: string;
  /** страница „Начало“ – заглавието е „Име – подзаглавие“ */
  home?: boolean;
}
const { locale, title, description, image, type = 'website', jsonLd, noindex = false, published, modified, alt = {}, fallback, home = false } = Astro.props;
const info = localeInfo[locale];
const text = siteText[locale];
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = home ? `${text.name} – ${text.tagline}` : `${title} | ${text.name}`;
const robots = noindex || site.noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
const nav = [
  { href: href(locale, 'recipes'), label: t(locale, 'nav.recipes') },
  { href: href(locale, 'categories'), label: t(locale, 'nav.categories') },
  { href: href(locale, 'search'), label: t(locale, 'nav.search') },
  { href: href(locale, 'shopping'), label: t(locale, 'nav.shopping') },
  { href: href(locale, 'favorites'), label: t(locale, 'nav.favorites') },
];
const path = Astro.url.pathname;
const abs = (p: string) => new URL(p, Astro.site).href;
// Картинка за споделяне: своята на страницата (напр. снимката на рецептата), иначе вертикалното лого (1200×630)
const ogImage = image ?? { url: abs('/brand/og-logo.jpg'), width: 1200, height: 630, alt: t(locale, 'brand.logoAlt') };
const other = otherLocale(locale);
const switchHref = alt[other] ?? fallback ?? href(other);
// Взаимни hreflang само когато и двата езика наистина съществуват
const pair = !noindex && alt.bg && alt.en;
const switchTo: Record<Locale, string> = { bg: alt.bg ?? '', en: alt.en ?? '' };
switchTo[locale] = alt[locale] ?? path;
switchTo[other] = switchHref;
---
<!doctype html>
<html lang={info.lang} data-locale={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {pair && locales.map((l) => <link rel="alternate" hreflang={localeInfo[l].lang} href={abs(alt[l]!)} />)}
    {pair && <link rel="alternate" hreflang="x-default" href={abs(alt.bg!)} />}
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={t(locale, 'rss.title', { name: text.name })} href={`/${locale}/rss.xml`} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/lora-cyrillic-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-sans-3-cyrillic-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-sans-3-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:site_name" content={text.name} />
    <meta property="og:locale" content={info.og} />
    {pair && <meta property="og:locale:alternate" content={localeInfo[other].og} />}
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage.url} />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    {ogImage.alt && <meta property="og:image:alt" content={ogImage.alt} />}
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.url} />

    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t(locale, 'skip.main')}</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={href(locale)} aria-label={t(locale, 'brand.home', { name: text.name })}>
          {/* Знакът на логото (декоративен: името на сайта е текст до него и в aria-label на връзката) */}
          <img class="brand-mark" src="/brand/mark-80.webp" srcset="/brand/mark-80.webp 2x, /brand/mark-120.webp 3x" width="36" height="36" alt="" decoding="async" />
          <span class="brand-text">{text.name}</span>
        </a>
        <nav class="main-nav" aria-label={t(locale, 'nav.label')}>
          <ul>
            {nav.map((n) => (
              <li><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
        <div class="header-tools">
        <div class="account" data-account>
          <a class="account-link" href={href(locale, 'login')} data-account-link title={t(locale, 'nav.signIn')} aria-current={path === href(locale, 'login') ? 'page' : undefined}>
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24"><path fill="currentColor" d="M12 12a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9Zm0 2c-4.4 0-8 2.5-8 5.5V21h16v-1.5c0-3-3.6-5.5-8-5.5Z"/></svg>
            <span class="account-label">{t(locale, 'nav.signIn')}</span>
          </a>
        </div>
        <nav class="lang-switch" aria-label={`${t('bg', 'lang.label')} / ${t('en', 'lang.label')}`} data-lang-switch>
          {locales.map((l, i) => (
            <>
              {i > 0 && <span aria-hidden="true" class="lang-sep">|</span>}
              {l === locale
                ? <a lang={l} hreflang={l} href={switchTo[l]} aria-current="true" title={localeInfo[l].name} data-lang={l}>{l.toUpperCase()}</a>
                : <a lang={l} hreflang={l} href={switchTo[l]} title={t(locale, 'lang.switchTo', { language: localeInfo[l].name })} aria-label={`${l.toUpperCase()} – ${t(locale, 'lang.switchTo', { language: localeInfo[l].name })}`} data-lang={l}>{l.toUpperCase()}</a>}
            </>
          ))}
        </nav>
        <button type="button" class="theme-toggle" data-theme-toggle data-label-dark={t(locale, 'theme.dark')} data-label-light={t(locale, 'theme.light')} aria-pressed="false" title={t(locale, 'theme.dark')}>
          <span class="theme-icon" aria-hidden="true">◐</span><span class="theme-label">{t(locale, 'theme.dark')}</span>
        </button>
        </div>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      {/* Декоративна бягаща лента с името и мотото (същият текст е в заглавката и по-долу; при намалено движение стои неподвижно) */}
      <div class="footer-marquee" aria-hidden="true">
        <div class="marquee-track">
          {[0, 1, 2, 3].map(() => <><span>{text.name}</span><span>{text.tagline}</span></>)}
        </div>
      </div>
      <div class="wrap footer-grid">
        <div class="footer-brand">
          <img src="/brand/mark-80.webp" width="44" height="44" alt="" decoding="async" loading="lazy" />
          <div>
            <p class="footer-name">{text.name}</p>
            <p class="footer-tagline">{text.tagline}</p>
          </div>
        </div>
        <nav aria-label={t(locale, 'footer.navLabel')}>
          <p class="footer-h">{t(locale, 'footer.explore')}</p>
          <ul class="footer-links">
            {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          </ul>
        </nav>
        <div class="footer-inner">
          <p class="footer-h">{t(locale, 'footer.info')}</p>
          <ul class="footer-links">
            <li><a href={`/${locale}/rss.xml`}>{t(locale, 'footer.rss')}</a></li>
            <li><a href="/sitemap-index.xml">{t(locale, 'footer.sitemap')}</a></li>
            <li><a href={href(locale, 'privacy')}>{t(locale, 'footer.privacyLink')}</a></li>
          </ul>
          <p class="footer-note">{t(locale, 'footer.privacy')}</p>
        </div>
      </div>
      <div class="wrap footer-bottom">
        <p>{t(locale, 'footer.copyright', { year: new Date().getFullYear(), holder: copyrightHolder[locale] })}</p>
      </div>
    </footer>
    {/* Известие за бисквитките и личните данни (GDPR). Сайтът ползва само необходими бисквитки, затова няма нужда от избор „приемам/отказвам“ –
        известието информира и се затваря с „Разбрах“ (запомня се в браузъра). Без JavaScript не се показва: тогава не се записва и нищо. */}
    <section class="cookie-notice" data-cookie-notice hidden aria-labelledby="cookie-notice-title">
      <div class="wrap cookie-inner">
        <div class="cookie-text">
          <h2 id="cookie-notice-title" class="cookie-title">{t(locale, 'cookies.title')}</h2>
          <p class="cookie-long">{t(locale, 'cookies.text')}</p>
          <p class="cookie-long">{t(locale, 'cookies.gdpr')}</p>
          <p class="cookie-short">{t(locale, 'cookies.short')}</p>
          <p><a href={`${href(locale, 'privacy')}#biskvitki`}>{t(locale, 'cookies.more')}</a></p>
        </div>
        <button type="button" class="btn small" data-cookie-ok>{t(locale, 'cookies.ok')}</button>
      </div>
    </section>
    <script>
      import '../scripts/summary';
      import '../scripts/header-account';
      import '../scripts/cookie-notice';
      import '../scripts/motion';
    </script>
    <script>
      const root = document.documentElement;
      const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      const mq = window.matchMedia('(prefers-color-scheme: dark)');
      const current = () => root.dataset.theme ?? (mq.matches ? 'dark' : 'light');
      const sync = () => {
        const dark = current() === 'dark';
        btn?.setAttribute('aria-pressed', String(dark));
      };
      btn?.addEventListener('click', () => {
        const next = current() === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
        sync();
      });
      sync();

      // Превключвател на езика: запазва филтрите (?…) и котвата (#…) на страницата и помни явния избор на посетителя.
      // Няма автоматично пренасочване по език на браузъра – адресът винаги решава езика.
      document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch] a').forEach((a) => {
        const base = a.getAttribute('href') ?? '';
        const keep = () => { if (a.getAttribute('aria-current') !== 'true' && !base.includes('?')) a.href = base + location.search + location.hash; };
        keep();
        window.addEventListener('hashchange', keep);
        a.addEventListener('click', () => { try { localStorage.setItem('lang', a.dataset.lang ?? ''); } catch {} });
      });
    </script>
  </body>
</html>
