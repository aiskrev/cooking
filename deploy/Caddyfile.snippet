# Блок за Caddyfile на сървъра – статичен сайт с рецепти.
# Подменете recepti.example.bg с вашия домейн/поддомейн (DNS A запис към IP на сървъра).
# ВАЖНО: добавя се като ОТДЕЛЕН блок; не пипайте блоковете на другите сайтове.
# Файловете на сайта са в /srv/recipes/current (виж README, раздел „Публикуване на VPS“).
# Ако Caddy върви в Docker, тази папка трябва да е монтирана в контейнера само за четене:
#     - /srv/recipes:/srv/recipes:ro

recepti.example.bg {
	root * /srv/recipes/current
	encode zstd gzip

	# --- Сигурни заглавки ---
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}
	# (Политиката за съдържанието – скриптове, снимки, шрифтове – е в самите HTML страници
	#  и съдържа хешове на вградените скриптове; не я дублирайте тук.)

	# --- Кеширане ---
	# Снимки, CSS: имената съдържат хеш на съдържанието → кеш за година, неизменно.
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	# Шрифтове: стабилни имена, без хеш → 30 дни.
	@fonts path /fonts/* /favicon.svg
	header @fonts Cache-Control "public, max-age=2592000"
	# Индекс за търсене (Pagefind): част от файловете са с хеш, входните – не → кратък кеш.
	@pagefind path /pagefind/*
	header @pagefind Cache-Control "public, max-age=3600"
	# HTML, RSS, sitemap: винаги се проверяват (ETag) → нова рецепта се вижда веднага.
	@pages not path /_astro/* /fonts/* /pagefind/* /favicon.svg
	header @pages Cache-Control "public, max-age=0, must-revalidate"

	file_server {
		precompressed zstd gzip
	}

	handle_errors {
		rewrite * /404.html
		file_server
	}
}
