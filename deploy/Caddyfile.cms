# Локален преглед с администрация: Caddy сервира статичната версия на сайта и препраща /admin и /api към Node услугата.
# Само за локален преглед (без TLS). Продукцията ползва HTTPS – вижте docs/LOCAL_RUNBOOK.md, раздел „Преди публично пускане“.
{
	auto_https off
	admin off
}

:8080 {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		?Content-Security-Policy "frame-ancestors 'none'"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	# Администрация и API
	@cms path /admin /admin/* /api/*
	handle @cms {
		reverse_proxy cms:3000 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Статичният сайт: текущата версия е символична връзка /srv/current -> /srv/<версия>
	handle {
		root * /srv/current

		@hashed path /_astro/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@fonts path /fonts/* /favicon.svg
		header @fonts Cache-Control "public, max-age=2592000"
		@pagefind path /pagefind/*
		header @pagefind Cache-Control "public, max-age=3600"
		@pages not path /_astro/* /fonts/* /pagefind/* /favicon.svg
		header @pages Cache-Control "public, max-age=0, must-revalidate"

		file_server
	}

	handle_errors {
		rewrite * /404.html
		root * /srv/current
		file_server
	}
}
